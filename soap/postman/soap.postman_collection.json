{
  "info": {
    "_postman_id": "523cdb40-41d1-5309-aff4-9a0030879623",
    "name": "Delivery SOAP API",
    "description": "Pickup point SOAP service. Start the API first (port 8082), then run the folders in order. No login is needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. WSDL",
      "item": [
        {
          "name": "Get the generated WSDL",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/services/pickup-points?wsdl",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Has the main WSDL parts\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('<wsdl:types>');",
                  "    pm.expect(xml).to.include('<wsdl:portType name=\"PickupPointPort\">');",
                  "    pm.expect(xml).to.include('<wsdl:binding name=\"PickupPointServiceSoapBinding\"');",
                  "    pm.expect(xml).to.include('<wsdl:service name=\"PickupPointService\">');",
                  "});",
                  "pm.test(\"Has the 4 operations\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('<wsdl:operation name=\"getPickupPoint\">');",
                  "    pm.expect(xml).to.include('<wsdl:operation name=\"findPickupPointsByCity\">');",
                  "    pm.expect(xml).to.include('<wsdl:operation name=\"reserveLocker\">');",
                  "    pm.expect(xml).to.include('<wsdl:operation name=\"cancelReservation\">');",
                  "});",
                  "pm.test(\"Has the 3 faults\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('name=\"NotFoundFault\"');",
                  "    pm.expect(xml).to.include('name=\"InvalidInputFault\"');",
                  "    pm.expect(xml).to.include('name=\"PickupPointFullFault\"');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Read operations",
      "item": [
        {
          "name": "getPickupPoint (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "url": "{{baseUrl}}/services/pickup-points",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:pic=\"http://delivery.ek.dk/pickup\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <pic:getPickupPoint><id>1</id></pic:getPickupPoint>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Is not a fault\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.not.include('<soap:Fault>');",
                  "});",
                  "pm.test(\"Returns pickup point 1\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('<ns2:getPickupPointResponse');",
                  "    pm.expect(xml).to.include('<id>1</id>');",
                  "    pm.expect(xml).to.include('<name>Norreport Lockers</name>');",
                  "    pm.expect(xml).to.include('<capacity>3</capacity>');",
                  "    pm.expect(xml).to.include('<freeLockers>2</freeLockers>');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "getPickupPoint - unknown id (negative, NotFoundFault)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "url": "{{baseUrl}}/services/pickup-points",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:pic=\"http://delivery.ek.dk/pickup\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <pic:getPickupPoint><id>99</id></pic:getPickupPoint>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 500\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test(\"Is a SOAP fault: NotFoundFault\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('<soap:Fault>');",
                  "    pm.expect(xml).to.include('<faultstring>Pickup point 99 not found</faultstring>');",
                  "    pm.expect(xml).to.include('<ns1:NotFoundFault ');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "getPickupPoint - id is not a number (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "url": "{{baseUrl}}/services/pickup-points",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:pic=\"http://delivery.ek.dk/pickup\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <pic:getPickupPoint><id>abc</id></pic:getPickupPoint>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 500\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test(\"CXF rejects the XML with a Client fault\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('<soap:Fault>');",
                  "    pm.expect(xml).to.include('<faultcode>soap:Client</faultcode>');",
                  "    pm.expect(xml).to.include('Unmarshalling Error');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "findPickupPointsByCity (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
