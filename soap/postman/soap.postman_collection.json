              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 500\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test(\"Is a SOAP fault: InvalidInputFault\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('<soap:Fault>');",
                  "    pm.expect(xml).to.include('<faultstring>city must be 1-50 letters</faultstring>');",
                  "    pm.expect(xml).to.include('<ns1:InvalidInputFault ');",
                  "});",
                  "pm.test(\"The script is not echoed back\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.not.include('script');",
                  "});"
                ]
              }
            }
          ]
        }
