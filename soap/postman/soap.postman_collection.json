    {
      "name": "3. Change operations",
      "item": [
        {
          "name": "reserveLocker (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "url": "{{baseUrl}}/services/pickup-points",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:pic=\"http://delivery.ek.dk/pickup\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <pic:reserveLocker><pickupPointId>2</pickupPointId><trackingNumber>DK-555555</trackingNumber></pic:reserveLocker>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Is not a fault\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.not.include('<soap:Fault>');",
                  "});",
                  "pm.test(\"Returns an ACTIVE reservation\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('<pickupPointId>2</pickupPointId>');",
                  "    pm.expect(xml).to.include('<trackingNumber>DK-555555</trackingNumber>');",
                  "    pm.expect(xml).to.include('<status>ACTIVE</status>');",
                  "});",
                  "pm.test(\"Save the new reservation id\", function () {",
                  "    const xml = pm.response.text();",
                  "    const id = xml.match(/<reservation><id>(\\d+)<\\/id>/)[1];",
                  "    pm.collectionVariables.set('reservationId', id);",
                  "});"
                ]
              }
            }
          ]
