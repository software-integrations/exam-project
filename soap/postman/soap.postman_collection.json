            ],
            "url": "{{baseUrl}}/services/pickup-points",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:pic=\"http://delivery.ek.dk/pickup\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <pic:findPickupPointsByCity><city>copenhagen</city></pic:findPickupPointsByCity>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Is not a fault\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.not.include('<soap:Fault>');",
                  "});",
                  "pm.test(\"Returns the Copenhagen pickup points\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include('<name>Norreport Lockers</name>');",
                  "    pm.expect(xml).to.include('<name>Amager Kiosk</name>');",
                  "});",
                  "pm.test(\"Returns exactly 2 pickup points\", function () {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml.split('<pickupPoint>').length - 1).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
