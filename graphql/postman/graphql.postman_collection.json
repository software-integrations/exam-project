    {
      "name": "4. ETL",
      "item": [
        {
          "name": "runEtl - first run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/graphql",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { runEtl { customersExtracted parcelsExtracted warehouseCustomers warehouseParcels } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Everything from the shards is in the warehouse\", function () {",
                  "    const json = pm.response.json();",
                  "    const r = json.data.runEtl;",
                  "    pm.expect(r.warehouseCustomers).to.eql(r.customersExtracted);",
                  "    pm.expect(r.warehouseParcels).to.eql(r.parcelsExtracted);",
                  "    pm.collectionVariables.set('warehouseCustomers', r.warehouseCustomers);",
                  "    pm.collectionVariables.set('warehouseParcels', r.warehouseParcels);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "runEtl - second run creates no duplicates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/graphql",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { runEtl { customersExtracted parcelsExtracted warehouseCustomers warehouseParcels } }\"\n}",
