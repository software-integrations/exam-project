{
  "info": {
    "_postman_id": "763b1d5e-618c-5628-9582-f4f3b296e47b",
    "name": "Delivery GraphQL API + ETL",
    "description": "Run the folders in order on a freshly started API (restart the API to reset the data). GraphQL always answers HTTP 200; errors are in the 'errors' list.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Queries (public)",
      "item": [
        {
          "name": "customers - all shards",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/graphql",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ customers { id shard email name } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"9 customers, spread over all 3 shards\", function () {",
                  "    const json = pm.response.json();",
                  "    const shards = new Set(json.data.customers.map(c => c.shard));",
                  "    pm.expect(json.data.customers).to.have.lengthOf(9);",
                  "    pm.expect([...shards].sort()).to.eql([0, 1, 2]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "customer by email - one shard, with parcels",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/graphql",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ customer(email: \\\"anna@example.com\\\") { name city shard parcels { description weightKg status } } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns Anna with her 2 parcels\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.customer.name).to.eql('Anna Jensen');",
                  "    pm.expect(json.data.customer.parcels).to.have.lengthOf(2);",
                  "});"
                ]
              }
            }
          ]
        },
