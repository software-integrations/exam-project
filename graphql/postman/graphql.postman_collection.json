                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Warehouse counts did not change\", function () {",
                  "    const json = pm.response.json();",
                  "    const r = json.data.runEtl;",
                  "    pm.expect(r.warehouseCustomers).to.eql(Number(pm.collectionVariables.get('warehouseCustomers')));",
                  "    pm.expect(r.warehouseParcels).to.eql(Number(pm.collectionVariables.get('warehouseParcels')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
