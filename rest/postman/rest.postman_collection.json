                  "});",
                  "pm.test(\"Only customers from Copenhagen\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.items).to.have.lengthOf(4);",
                  "    json.items.forEach(c => pm.expect(c.city).to.eql('Copenhagen'));",
                  "});"
