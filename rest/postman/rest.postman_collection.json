    {
      "name": "2. Customers",
      "item": [
        {
          "name": "List customers - page 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/customers?page=1&size=5",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Pagination works\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.items).to.have.lengthOf(5);",
                  "    pm.expect(json.totalItems).to.eql(12);",
                  "    pm.expect(json.totalPages).to.eql(3);",
                  "});",
                  "pm.test(\"HATEOAS: next link but no prev link on page 1\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json._links.next.href).to.include('page=2');",
                  "    pm.expect(json._links.prev).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/customers?search=copenhagen",
            "description": ""
