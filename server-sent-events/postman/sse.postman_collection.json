    {
      "name": "3. Manual demo (never ends - do not use in the runner)",
      "item": [
        {
          "name": "Live stream of delivery 1 (manual demo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": "{{baseUrl}}/api/v1/deliveries/1/events",
            "description": "Stays open (not for the collection runner). Send it in one tab, then send the POST requests in another tab and watch the events arrive.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
